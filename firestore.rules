rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'admin@pctracker.com';
    }
    
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow read, write: if isAdmin() || isOwner(uid);
    }

    match /devices/{deviceId} {
      allow read, write: if isAdmin() || (request.auth != null && deviceId.matches('.*_' + request.auth.uid));
    }

    match /runningApps/{deviceId} {
      allow read, write: if isAdmin() || (request.auth != null && deviceId.matches('.*_' + request.auth.uid));
    }
    
    match /activities/{docId} {
      allow read, write: if isAdmin() || (request.auth != null && request.resource.data.userId == request.auth.uid);
    }
    
    match /sessions/{docId} {
      allow read, write: if isAdmin() || (request.auth != null && request.resource.data.uid == request.auth.uid);
    }

    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
