{
  "name": "pc-tracker",
  "private": true,
  "version": "1.0.0",
  "description": "Smart System Activity Tracker & Monitoring Dashboard",
  "author": "PC Tracker Team",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite --port 3000",
    "build": "vite build",
    "preview": "vite preview",
    "electron": "electron .",
    "electron:dev": "concurrently \"cross-env BROWSER=none npm run dev\" \"wait-on http://localhost:3000; electron .\"",

    "electron:build": "npm run build && electron-builder",
    "dist:win:nsis:both": "npm run build && electron-builder --win nsis --x64 --ia32",
    "dist:win:portable:both": "npm run build; electron-builder --win portable --x64 --ia32",
    "dist:win:all:both": "npm run build; electron-builder --win nsis portable --x64 --ia32",

    "agent": "node agent/tracker.js",
    "monitor": "node server/monitor.js",
    "export": "node agent/export_csv.js"
  },
  "build": {
    "appId": "com.pctracker.app",
    "productName": "PC Tracker",
    "directories": {
      "output": "dist"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "server/**/*",
      "public/**/*"
    ],

    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64", "ia32"]
        },
        {
          "target": "portable",
          "arch": ["x64", "ia32"]
        }
      ],
      "icon": "public/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "active-win": "^8.2.1",
    "concurrently": "^9.2.1",
    "cors": "^2.8.6",
    "cross-env": "^10.1.0",
    "electron-is-dev": "^3.0.1",
    "express": "^5.2.1",
    "firebase": "^12.13.0",
    "framer-motion": "^12.38.0",
    "lucide-react": "^1.14.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-router-dom": "^7.15.0",
    "recharts": "^3.8.1",
    "screenshot-desktop": "^1.15.4",
    "systeminformation": "^5.31.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "electron": "^42.0.1",
    "electron-builder": "^26.8.1",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "vite": "^8.0.10",
    "wait-on": "^8.0.5"
  }
}
